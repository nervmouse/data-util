{
  "name": "@nervmouse/data-util",
  "version": "2.0.0",
  "description": "data util",
  "main": "dist/data-util.js",
  "types": "dist/data-util.d.ts",
  "module": "./dist/data-util.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsup",
    "prepublishOnly": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nervmouse/data-util.git"
  },
  "author": "Jim Chen",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nervmouse/data-util/issues"
  },
  "homepage": "https://github.com/nervmouse/data-util#readme",
  "dependencies": {
    "@nervmouse/object-util": "^2.0.0",
    "mathjs": "^14.5.3",
    "mingo": "^6.6.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@9.6.0",
  "tsup": {
    "entry": [
      "src/data-util.ts"
    ],
    "format": [
      "cjs",
      "esm"
    ],
    "splitting": false,
    "sourcemap": true,
    "clean": true,
    "dts": true
  }
}
